{
  "name": "skills-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=24.20.0",
    "bun": "1.4.1"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "type-check": "astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "astro": "^7.3.5",
    "satteri-expressive-code": "^0.1.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "satori": "^0.33.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
