---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import { buildAssetPath, buildCanonicalUrl } from "../lib/site-paths";
import { getOgImagePath } from "../lib/route-metadata";
import { SITE } from "../lib/site-metadata";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const ogImageUrl = new URL(getOgImagePath(Astro.url.pathname), `${SITE.url}/`).href;
const fontMonoUrl = buildAssetPath(import.meta.env.BASE_URL, "fonts/IBMPlexMono-Regular.woff2");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    <meta name="title" content={title} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <ClientRouter />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={buildAssetPath(import.meta.env.BASE_URL, "favicon.svg")} />
    <link rel="icon" type="image/x-icon" href={buildAssetPath(import.meta.env.BASE_URL, "favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={buildAssetPath(import.meta.env.BASE_URL, "apple-touch-icon.png")} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={fontMonoUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} preview`} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en-US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} preview`} />

    <title>{title}</title>
  </head>
  <body>
    <a href={buildAssetPath(import.meta.env.BASE_URL, "#main-content")} class="skip-link">Skip to content</a>
    <header class="site-topbar rise">
      <div class="topbar-inner">
        <a class="brand" href={import.meta.env.BASE_URL}>skills</a>
        <nav class="topnav" aria-label="Primary">
          <a href={buildAssetPath(import.meta.env.BASE_URL, "all/")}>all</a>
          <a href="https://abijith.sh" target="_blank" rel="noopener noreferrer">
            abijith.sh <span class="ext-arrow" aria-hidden="true">&nearr;</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
