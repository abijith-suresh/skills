---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="404 | Skills" description="Page not found" noindex>
  <section class="page-shell">
    <p class="eyebrow">404</p>
    <h1 style="margin-top:var(--space-xs)">Page not found</h1>
    <p class="page-description" style="margin-top:var(--space-2xs)">
      The skill you're looking for doesn't exist.
    </p>
    <a href={import.meta.env.BASE_URL} class="text-link" style="display:inline-block;margin-top:var(--space-l)">
      Back to skills
    </a>
  </section>
</SiteLayout>
