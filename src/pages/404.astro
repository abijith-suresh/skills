---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="404 | skills" description="Page not found" noindex>
  <section class="page-shell">
    <p class="eyebrow rise" style="--d: 80ms">404</p>
    <h1 class="rise" style="margin-top:var(--space-xs); --d: 160ms">page not found</h1>
    <p class="page-description rise" style="margin-top:var(--space-2xs); --d: 240ms">
      The skill you're looking for doesn't exist.
    </p>
    <a
      href={import.meta.env.BASE_URL}
      class="text-link rise"
      style="display:inline-block;margin-top:var(--space-l); --d: 320ms"
    >
      back to skills
    </a>
  </section>
</SiteLayout>
