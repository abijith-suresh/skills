---
import { getCollection, getEntry, render } from 'astro:content';

import CommandCopy from '../components/CommandCopy.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { buildSkillSummaries } from '../lib/skill-catalog';
import { buildCatalogPath } from '../lib/site-paths';

export async function getStaticPaths() {
  const definitions = await getCollection('skillDefinitions');

  return definitions.map((definition) => ({
    params: { skill: definition.id },
  }));
}

const slug = Astro.params.skill;
if (!slug) {
  throw new Error('Expected a skill slug.');
}

const definition = await getEntry('skillDefinitions', slug);
if (!definition) {
  throw new Error(`Missing skill definition for ${slug}.`);
}

const readme = await getEntry('skillReadmes', slug);
const [summary] = buildSkillSummaries([definition]);
const { Content: DefinitionContent } = await render(definition);
const readmeRender = readme ? await render(readme) : null;
const ReadmeContent = readmeRender?.Content;
const catalogPath = buildCatalogPath(import.meta.env.BASE_URL);
---

<SiteLayout title={`${summary.name} | Skills`} description={summary.description}>
  <!-- Navigation -->
  <div class="site-container pt-8 pb-4">
    <a href={catalogPath} class="nav-pill">← Back to all skills</a>
  </div>

  <!-- Hero -->
  <section class="site-container pt-8 pb-16">
    <p class="eyebrow">{summary.slug}</p>
    <h1 class="heading-xl mt-4 max-w-4xl">{summary.name}</h1>
    <p class="body-copy mt-6 max-w-3xl">{summary.description}</p>

    <!-- Action bar: install + view source, equal height -->
    <div class="mt-8">
      <p class="eyebrow mb-3">Install this skill</p>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-stretch">
        <div class="flex-1 min-w-0">
          <CommandCopy
            command={summary.installCommand}
            buttonLabel="Copy"
          />
        </div>
        <a
          href={summary.sourceUrl}
          target="_blank"
          rel="noreferrer"
          class="btn justify-center"
        >
          View source ↗
        </a>
      </div>
    </div>
  </section>

  <hr class="site-container !border-t !border-t-[color-mix(in_srgb,var(--text)_12%,transparent)]" />

  <!-- Content: README then SKILL.md (stacked vertically) -->
  <section class="site-container pt-16 pb-24">
    <div class="max-w-4xl">
      <!-- README -->
      <div>
        <p class="eyebrow">README</p>
        <h2 class="heading-md mt-3">Usage, install, and prompts</h2>
        <div class="card mt-6">
          {
            ReadmeContent ? (
              <div class="markdown">
                <ReadmeContent />
              </div>
            ) : (
              <p class="body-sm">
                This skill does not currently include a README.
              </p>
            )
          }
        </div>
      </div>

      <!-- SKILL.md -->
      <div class="mt-16">
        <p class="eyebrow">SKILL.md</p>
        <h2 class="heading-md mt-3">Definition read by the agent</h2>
        <div class="card mt-6">
          <div class="markdown">
            <DefinitionContent />
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
