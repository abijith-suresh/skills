---
import { getCollection, getEntry, render } from 'astro:content';

import Breadcrumb from '../components/Breadcrumb.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  buildSkillSummaries,
  parseReadmeBody,
} from '../lib/skill-catalog';
import { buildCatalogPath } from '../lib/site-paths';

export async function getStaticPaths() {
  const definitions = await getCollection('skillDefinitions');

  return definitions.map((definition) => ({
    params: { skill: definition.id },
  }));
}

const slug = Astro.params.skill;
if (!slug) {
  throw new Error('Expected a skill slug.');
}

const definition = await getEntry('skillDefinitions', slug);
if (!definition) {
  throw new Error(`Missing skill definition for ${slug}.`);
}

const readmeEntry = await getEntry('skillReadmes', slug);
const [summary] = buildSkillSummaries([definition]);

const readmeBody = readmeEntry?.body ?? '';
const { name: heroName, description: heroDescription } = readmeBody
  ? parseReadmeBody(readmeBody)
  : { name: summary.name, description: summary.description };

const { Content: DefinitionContent } = await render(definition);
const readmeRender = readmeEntry ? await render(readmeEntry) : null;
const ReadmeContent = readmeRender?.Content;
const catalogPath = buildCatalogPath(import.meta.env.BASE_URL);
---

<SiteLayout title={`${heroName} | Skills`} description={heroDescription}>
  <div class="site-container pt-6 pb-4">
    <Breadcrumb
      crumbs={[
        { label: 'skills', href: catalogPath },
        { label: slug },
      ]}
    />
  </div>

  <section class="site-container pt-2 pb-16">
    <h1 class="skill-title">{heroName}</h1>
    <p class="body-copy mt-4" style="max-width: 60ch; color: var(--color-muted-foreground);">
      {heroDescription}
    </p>

    <div class="mt-8">
      <p class="eyebrow mb-2">Installation</p>
      <div class="install-block">
        <code>{summary.installCommand}</code>
        <button
          type="button"
          class="copy-btn"
          data-copy-command={summary.installCommand}
          data-copy-default="Copy"
        >
          Copy
        </button>
      </div>
      <a
        href={summary.sourceUrl}
        target="_blank"
        rel="noreferrer"
        class="link mt-3 inline-block"
        style="font-size: 0.875rem;"
      >
        View source ↗
      </a>
    </div>
  </section>

  <section class="site-container pb-24">
    <div class="section-label">
      <p class="eyebrow">Overview</p>
    </div>

    <div class="markdown" style="max-width: 72ch;">
      {ReadmeContent ? (
        <ReadmeContent />
      ) : (
        <p style="color: var(--color-muted-foreground);">This skill does not currently include a README.</p>
      )}
    </div>

    <details class="details-collapse mt-12">
      <summary>
        <span class="chevron" aria-hidden="true">▸</span>
        SKILL.md
      </summary>
      <div class="markdown mt-4" style="max-width: 72ch;">
        <DefinitionContent />
      </div>
    </details>
  </section>
</SiteLayout>
