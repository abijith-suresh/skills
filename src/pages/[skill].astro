---
import { getCollection, getEntry, render } from 'astro:content';

import ActionBar from '../components/ActionBar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DocSection from '../components/DocSection.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  buildSkillSummaries,
  parseReadmeBody,
} from '../lib/skill-catalog';
import { buildCatalogPath } from '../lib/site-paths';

export async function getStaticPaths() {
  const definitions = await getCollection('skillDefinitions');

  return definitions.map((definition) => ({
    params: { skill: definition.id },
  }));
}

const slug = Astro.params.skill;
if (!slug) {
  throw new Error('Expected a skill slug.');
}

const definition = await getEntry('skillDefinitions', slug);
if (!definition) {
  throw new Error(`Missing skill definition for ${slug}.`);
}

const readmeEntry = await getEntry('skillReadmes', slug);
const [summary] = buildSkillSummaries([definition]);

// Parse hero info from README body, fall back to SKILL.md frontmatter
const readmeBody = readmeEntry?.body ?? '';
const { name: heroName, description: heroDescription } = readmeBody
  ? parseReadmeBody(readmeBody)
  : { name: summary.name, description: summary.description };

const { Content: DefinitionContent } = await render(definition);
const readmeRender = readmeEntry ? await render(readmeEntry) : null;
const ReadmeContent = readmeRender?.Content;
const catalogPath = buildCatalogPath(import.meta.env.BASE_URL);
---

<SiteLayout title={`${heroName} | Skills`} description={heroDescription}>
  <div class="site-container pt-4 pb-4">
    <Breadcrumb
      crumbs={[
        { label: 'skills', href: catalogPath },
        { label: slug },
      ]}
    />
  </div>

  <PageHero
    title={heroName}
    description={heroDescription}
    sectionClass="pt-4 pb-16"
    titleClass="max-w-4xl"
    descriptionClass="max-w-3xl"
  >
    <div slot="actions">
      <p class="eyebrow mb-3">Install this skill</p>
      <ActionBar
        command={summary.installCommand}
        buttonLabel="Copy"
        href={summary.sourceUrl}
        linkLabel="View source ↗"
      />
    </div>
  </PageHero>

  <hr class="site-container !border-t !border-t-[var(--color-border)]" />

  <section class="site-container pt-16 pb-24">
    <div class="max-w-4xl">
      <div data-scroll-reveal>
        <DocSection
          eyebrow="Documentation"
          heading="Usage, install, and prompts"
          fallbackText="This skill does not currently include a README."
          hasContent={!!ReadmeContent}
        >
          {ReadmeContent && <ReadmeContent />}
        </DocSection>
      </div>

      <div class="mt-16" data-scroll-reveal>
        <DocSection
          eyebrow="SKILL.md"
          heading="Instructions read by the agent"
        >
          <DefinitionContent />
        </DocSection>
      </div>
    </div>
  </section>
</SiteLayout>
