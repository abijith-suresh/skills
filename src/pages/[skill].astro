---
import { getCollection, getEntry, render } from "astro:content";

import InstallCommandBlock from "@/components/InstallCommandBlock.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PageShell from "@/components/ui/PageShell.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildInstallCommand, getSkillSummary, SKILLS_REPOSITORY } from "@/lib/skill-catalog";
import { buildPageTitle } from "@/lib/route-metadata";

export async function getStaticPaths() {
  const definitions = await getCollection("skillDefinitions");
  return definitions.map((definition) => ({
    params: { skill: definition.id },
  }));
}

const slug = Astro.params.skill;
if (!slug) {
  throw new Error("Skill route parameter is required");
}

const definition = await getEntry("skillDefinitions", slug);
if (!definition) {
  throw new Error(`Skill definition not found: ${slug}`);
}

const { Content } = await render(definition);
const installCommand = buildInstallCommand(SKILLS_REPOSITORY, slug);
const summary = getSkillSummary(definition.data);
---

<SiteLayout title={buildPageTitle(definition.data.name)} description={summary}>
  <article>
    <PageShell>
      <Fragment slot="header">
        <PageHeader title={definition.data.name} subtitle={summary} />
        <div class="detail-install rise" style="--d: 80ms">
          <InstallCommandBlock command={installCommand} />
        </div>
      </Fragment>
      <div class="prose rise" style="--d: 80ms">
        <Content />
      </div>
    </PageShell>
  </article>
</SiteLayout>

<style>
  .detail-install {
    margin-top: var(--space-s);
  }
</style>
