---
import { getCollection, getEntry, render } from "astro:content";

import InstallCommandBlock from "../components/InstallCommandBlock.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { buildInstallCommand, SKILLS_REPOSITORY } from "../lib/skill-catalog";

export async function getStaticPaths() {
  const definitions = await getCollection("skillDefinitions");
  return definitions.map((definition) => ({
    params: { skill: definition.id },
  }));
}

const slug = Astro.params.skill;
if (!slug) {
  throw new Error("Skill route parameter is required");
}

const definition = await getEntry("skillDefinitions", slug);
if (!definition) {
  throw new Error(`Skill definition not found: ${slug}`);
}

const { Content } = await render(definition);
const installCommand = buildInstallCommand(SKILLS_REPOSITORY, slug);
---

<SiteLayout title={`${definition.data.name} | Skills`} description={definition.data.description}>
  <article class="page-shell">
    <nav class="breadcrumb eyebrow rise" style="--d: 80ms" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL}>Skills</a>
      <span aria-hidden="true">/</span>
      <span translate="no">
        {definition.data.name}
      </span>
    </nav>

    <h1 class="detail-title rise" style="--d: 160ms" translate="no">
      {definition.data.name}<span class="detail-period" aria-hidden="true">.</span>
    </h1>

    <section class="detail-section">
      <div class="section-header">
        <h2 class="eyebrow">Install</h2>
      </div>
      <InstallCommandBlock command={installCommand} />
    </section>

    <section class="detail-section">
      <div class="section-header">
        <h2 class="eyebrow">Description</h2>
      </div>
      <p class="page-description">{definition.data.description}</p>
    </section>

    <section class="detail-section">
      <div class="section-header">
        <h2 class="eyebrow">SKILL.md</h2>
      </div>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  /* the Dusk Aurora signature: a Bricolage title ending in a glowing
     pink period. The glow lives on a layered copy of the period so its
     intensity can breathe by animating opacity instead of repainting
     text-shadow. */
  .detail-title {
    letter-spacing: -0.015em;
  }

  .detail-period {
    position: relative;
    display: inline-block;
    color: var(--color-pink);
  }

  .detail-period::after {
    content: ".";
    position: absolute;
    inset: 0;
    color: var(--color-pink);
    text-shadow:
      0 0 18px oklch(70.6% 0.078 302 / 0.6),
      0 0 36px oklch(83.9% 0.069 3 / 0.4);
    pointer-events: none;
    animation: detail-glow-breathe 22s ease-in-out infinite alternate;
  }

  @keyframes detail-glow-breathe {
    from {
      opacity: 0.75;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-period::after {
      animation: none;
    }
  }
</style>
