---
import { getCollection } from 'astro:content';

import CommandCopy from '../components/CommandCopy.astro';
import SkillCard from '../components/SkillCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  buildInstallCommand,
  buildSkillSummaries,
  SKILLS_REPOSITORY,
} from '../lib/skill-catalog';

const definitions = await getCollection('skillDefinitions');
const skills = buildSkillSummaries(definitions);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <section class="site-container pt-16 pb-8">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-6">
      <!-- Row 1: eyebrow above heading -->
      <div class="lg:col-span-8">
        <p class="eyebrow">abijith-suresh/skills</p>
        <h1 class="heading-xl mt-4">
          Personal AI agent skills, documented and ready to install.
        </h1>
      </div>

      <!-- Row 2: description -->
      <div class="lg:col-span-6">
        <p class="body-copy">
          A lightweight catalog of AI agent skills I reuse across projects.
          Browse, inspect, and install on any machine.
        </p>
      </div>

      <!-- Row 3: action row with equal-height copy + view -->
      <div class="lg:col-span-12 lg:mt-6">
        <p class="eyebrow mb-3">Install the full collection</p>
        <div class="flex flex-col gap-4 lg:flex-row lg:items-stretch">
          <div class="flex-1 min-w-0">
            <CommandCopy
              command={installEverythingCommand}
              buttonLabel="Copy"
            />
          </div>
          <a
            href="https://github.com/abijith-suresh/skills"
            target="_blank"
            rel="noreferrer"
            class="btn justify-center"
          >
            View repository ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container mt-24 pb-24">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-6 items-stretch">
      <div class="lg:col-span-12">
        <p class="eyebrow">Collection</p>
        <h2 class="heading-lg mt-3">Available skills</h2>
        <p class="body-sm mt-2 max-w-xl">
          Click any card to view the skill's full documentation and install command.
        </p>
      </div>

      {
        skills.map((skill) => (
          <div class="lg:col-span-4 h-full">
            <SkillCard skill={skill} />
          </div>
        ))
      }
    </div>
  </section>
</SiteLayout>
