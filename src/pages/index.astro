---
import { getCollection } from 'astro:content';

import CommandCopy from '../components/CommandCopy.astro';
import SkillCard from '../components/SkillCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  buildInstallCommand,
  buildSkillSummaries,
  SKILLS_REPOSITORY,
} from '../lib/skill-catalog';

const definitions = await getCollection('skillDefinitions');
const skills = buildSkillSummaries(definitions);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <section class="rounded-[2rem] border border-slate-800/80 bg-slate-900/65 p-8 shadow-2xl shadow-slate-950/35 backdrop-blur md:p-10">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-indigo-300">abijith-suresh/skills</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white md:text-5xl">
          Personal AI agent skills, documented and ready to install.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300 md:text-lg">
          This site is a lightweight catalog for the skills I refine in personal projects and then reuse
          everywhere else. Browse the collection, inspect each skill, and copy the latest install command
          straight into any machine where you want the same workflow.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:min-w-[18rem]">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/50 p-4">
          <p class="text-sm text-slate-400">Skills</p>
          <p class="mt-2 text-3xl font-semibold text-white">{skills.length}</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-950/50 p-4">
          <p class="text-sm text-slate-400">Hosted for</p>
          <p class="mt-2 text-lg font-semibold text-white">GitHub Pages</p>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-end">
      <CommandCopy
        command={installEverythingCommand}
        caption="Install the full collection"
        buttonLabel="Copy all"
      />

      <a
        href="https://github.com/abijith-suresh/skills"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-slate-700 bg-slate-950/60 px-5 py-4 text-sm font-medium text-slate-100 transition hover:border-slate-500 hover:bg-slate-950"
      >
        View repository ↗
      </a>
    </div>
  </section>

  <section class="mt-8">
    <div class="mb-5 flex items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold text-white">Available skills</h2>
        <p class="mt-1 text-sm text-slate-400">Each card links to a skill detail page and exposes a copy-ready install command.</p>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
      {skills.map((skill) => <SkillCard skill={skill} />)}
    </div>
  </section>
</SiteLayout>
