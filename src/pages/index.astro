---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import { buildInstallCommand, buildSkillSummaries, SKILLS_REPOSITORY } from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';

const definitions = await getCollection('skillDefinitions');
const readmes = await getCollection('skillReadmes');
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY, readmes);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <PageHero
    eyebrow="abijith-suresh/skills"
    title="Personal AI agent skills."
    description="A lightweight catalog of AI agent skills I reuse across projects. Browse, inspect, and install on any machine."
    sectionClass="pt-20 pb-10"
    titleClass="[max-width:20ch]"
  >
    <div slot="actions">
      <p class="text-xs font-medium tracking-[0.04em] uppercase text-muted mb-2">Install the full collection</p>
      <div class="flex items-center gap-2 bg-[color-mix(in_srgb,var(--color-text)_5%,var(--color-base))] px-4 py-[0.875rem] mt-2">
        <code class="flex-1 font-mono text-sm text-text whitespace-nowrap overflow-x-auto">{installEverythingCommand}</code>
        <button
          type="button"
          class="font-sans text-xs font-medium tracking-[0.04em] uppercase text-muted bg-none border-0 cursor-pointer px-[0.4rem] py-[0.2rem] shrink-0 transition-colors duration-150 hover:text-accent"
          data-copy-command={installEverythingCommand}
          data-copy-default="Copy"
        >
          Copy
        </button>
      </div>
    </div>
  </PageHero>

  <section class="mx-auto w-full max-w-[1200px] px-6 md:px-8 pb-24">
    <div class="border-t border-border pt-8 mb-4">
      <p class="text-xs font-medium tracking-[0.04em] uppercase text-muted">Skills</p>
    </div>

    <div>
      {skills.map((skill) => (
        <a
          href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)}
          class="group block px-3 py-5 -mx-3 border-b border-border no-underline text-inherit transition-[padding-left,background-color,color] duration-150 last:border-b-0 hover:bg-accent hover:pl-6"
        >
          <div class={`font-mono text-[1.05rem] font-semibold leading-[1.3] text-text group-hover:text-[var(--color-card-hover-text)]`}>{skill.name}</div>
          <p class={`text-[0.9rem] leading-[1.5] text-muted-foreground mt-[0.3rem] group-hover:text-[var(--color-card-hover-text)]`}>{skill.description}</p>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
