---
import { getCollection } from 'astro:content';

import SiteLayout from '../layouts/SiteLayout.astro';
import {
  buildInstallCommand,
  buildSkillSummaries,
  SKILLS_REPOSITORY,
} from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';

const definitions = await getCollection('skillDefinitions');
const readmes = await getCollection('skillReadmes');
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY, readmes);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <section class="site-container pt-12 pb-8">
    <p class="eyebrow">abijith-suresh/skills</p>
    <h1 class="heading-xl mt-4" style="max-width: 20ch;">
      Personal AI agent skills.
    </h1>
    <p class="body-copy mt-6" style="max-width: 55ch;">
      A lightweight catalog of AI agent skills I reuse across projects.
      Browse, inspect, and install on any machine.
    </p>
    <div class="mt-8">
      <p class="eyebrow mb-3">Install the full collection</p>
      <div class="install-block">
        <code>{installEverythingCommand}</code>
        <button
          type="button"
          class="copy-btn"
          data-copy-command={installEverythingCommand}
          data-copy-default="Copy"
        >
          Copy
        </button>
      </div>
    </div>
  </section>

  <section class="site-container pb-24">
    <div class="section-label">
      <p class="eyebrow">Skills</p>
    </div>

    <div>
      {skills.map((skill) => (
        <div class="skill-list-item">
          <div class="skill-name">
            <a href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)}>
              {skill.name}
            </a>
          </div>
          <p class="skill-desc">{skill.description}</p>
          <div class="skill-install">
            <code>{skill.installCommand}</code>
            <button
              type="button"
              class="copy-btn"
              data-copy-command={skill.installCommand}
              data-copy-default="Copy"
            >
              Copy
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
