---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import InstallCommandBlock from '../components/InstallCommandBlock.astro';
import { buildInstallCommand, buildSkillSummaries, SKILLS_REPOSITORY } from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';

const definitions = await getCollection('skillDefinitions');
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <PageHero
    eyebrow="abijith-suresh/skills"
    title="Skills"
    description="AI agent workflows I reach for every day."
    sectionClass="pt-20 pb-10"
    titleClass="max-w-[20ch]"
  >
    <div slot="actions">
      <InstallCommandBlock command={installEverythingCommand} label="Install the full collection" />
    </div>
  </PageHero>

  <section class="container-site pb-24">
    <SectionHeader eyebrow="Skills" as="h2" />

    <ul class="list-none p-0 m-0">
        {skills.map((skill) => (
          <li>
            <a
              href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)}
              class="group block px-3 py-5 -mx-3 border-b border-border no-underline text-inherit transition-colors duration-150 last:border-b-0 hover:bg-accent"
            >
              <div class="text-lg font-semibold leading-snug text-text group-hover:text-[var(--color-card-hover-text)]" translate="no">{skill.name}</div>
              <p class="text-sm text-muted-foreground mt-1 group-hover:text-[var(--color-card-hover-text)]">{skill.description}</p>
            </a>
          </li>
        ))}
    </ul>
  </section>
</SiteLayout>
