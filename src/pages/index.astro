---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import InstallCommandBlock from '../components/InstallCommandBlock.astro';
import { buildInstallCommand, buildSkillSummaries, SKILLS_REPOSITORY } from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';

const definitions = await getCollection('skillDefinitions');
const readmes = await getCollection('skillReadmes');
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY, readmes);
const installEverythingCommand = buildInstallCommand(SKILLS_REPOSITORY);
---

<SiteLayout
  title="Skills"
  description="Browse personal AI agent skills, copy install commands, and inspect each skill's docs before installing it on another machine."
>
  <PageHero
    eyebrow="abijith-suresh/skills"
    title="Personal AI agent skills."
    description="A lightweight catalog of AI agent skills I reuse across projects. Browse, inspect, and install on any machine."
    sectionClass="pt-20 pb-10"
    titleClass="[max-width:20ch]"
  >
    <div slot="actions">
      <InstallCommandBlock command={installEverythingCommand} label="Install the full collection" />
    </div>
  </PageHero>

  <section class="container-site pb-24">
    <SectionHeader eyebrow="Skills" as="h2" />

    <div>
      {skills.map((skill) => (
        <a
          href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)}
          class="group block px-3 py-5 -mx-3 border-b border-border no-underline text-inherit transition-[padding-left,background-color,color] duration-[var(--duration-fast)] last:border-b-0 hover:bg-accent hover:pl-6"
        >
          <div class={`font-mono text-body-lg font-semibold leading-[var(--leading-compact)] text-text group-hover:text-[var(--color-card-hover-text)]`}>{skill.name}</div>
          <p class={`text-body-sm text-muted-foreground mt-1 group-hover:text-[var(--color-card-hover-text)]`}>{skill.description}</p>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
