---
import { getCollection } from "astro:content";
import InstallCommandBlock from "@/components/InstallCommandBlock.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PageShell from "@/components/ui/PageShell.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/consts";
import { buildScopeInstallCommand, buildSkillSummaries, SKILLS_REPOSITORY } from "@/lib/skill-catalog";
import { buildPageTitle } from "@/lib/route-metadata";
import { buildAllPath, buildSkillPath } from "@/lib/site-paths";

const definitions = await getCollection("skillDefinitions");
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY);
const featuredSkills = skills.filter((skill) => skill.featured);
const personalInstallCommand = buildScopeInstallCommand(skills, "personal");
const workInstallCommand = buildScopeInstallCommand(skills, "work");
---

<SiteLayout title={buildPageTitle()} description={SITE.description}>
  <PageShell>
    <Fragment slot="header">
      <PageHeader title="skills" hero subtitle={SITE.description} />
      <div class="install-block rise" style="--d: 80ms">
        <InstallCommandBlock command={personalInstallCommand} label="Install for the personal laptop" />
        <InstallCommandBlock command={workInstallCommand} label="Install for the work laptop" />
      </div>
    </Fragment>

    <div class="section-header rise" style="--d: 80ms">
      <h2 class="section-title">favourite skills</h2>
      <a href={buildAllPath(import.meta.env.BASE_URL)} class="section-link">
        all skills
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <ul class="content-list">
      {featuredSkills.map((skill, index) => (
        <li class="rise" style={`--d: ${160 + Math.min(index, 7) * 70}ms`}>
          <a href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)} class="skill-card">
            <span class="skill-card-title" translate="no">{skill.name}</span>
            <span class="skill-card-description">{skill.summary}</span>
            <span class="skill-card-foot">Scope: {skill.scope}</span>
            <span class="skill-card-foot">
              read
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </PageShell>
</SiteLayout>

<style>
  .install-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
</style>
