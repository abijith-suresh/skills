---
import { getCollection } from "astro:content";
import PageShell from "@/components/ui/PageShell.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildSkillSummaries, SKILLS_REPOSITORY } from "@/lib/skill-catalog";
import { buildPageTitle } from "@/lib/route-metadata";
import { buildSkillPath } from "@/lib/site-paths";

const ALL_PAGE_DESCRIPTION = "Every skill in the collection.";

const definitions = await getCollection("skillDefinitions");
const skills = buildSkillSummaries(definitions, SKILLS_REPOSITORY);
---

<SiteLayout title={buildPageTitle("all skills")} description={ALL_PAGE_DESCRIPTION}>
  <PageShell title="all skills" subtitle={ALL_PAGE_DESCRIPTION}>
    <ul class="content-list">
      {skills.map((skill, index) => (
        <li class="rise" style={`--d: ${160 + Math.min(index, 7) * 70}ms`}>
          <a href={buildSkillPath(import.meta.env.BASE_URL, skill.slug)} class="skill-card">
            <span class="skill-card-title" translate="no">{skill.name}</span>
            <span class="skill-card-description">{skill.description}</span>
            <span class="skill-card-foot">
              read
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </PageShell>
</SiteLayout>
