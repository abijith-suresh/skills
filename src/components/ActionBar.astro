---
import CommandCopy from './CommandCopy.astro';

interface Props {
  command: string;
  buttonLabel: string;
  href?: string;
  linkLabel?: string;
}

const { command, buttonLabel, href, linkLabel } = Astro.props;
---

<div class="flex flex-col gap-2">
  <CommandCopy command={command} buttonLabel={buttonLabel} />
  {href && linkLabel && (
    <a
      href={href}
      target="_blank"
      rel="noreferrer"
      class="link text-xs"
    >
      {linkLabel}
    </a>
  )}
</div>
