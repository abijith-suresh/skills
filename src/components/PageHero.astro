---
interface Props {
  title: string;
  description: string;
  period?: boolean;
  hero?: boolean;
}

const { title, description, period = false, hero = false } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<header class="page-header rise" style="--d: 0ms">
  <h1 id="page-title" class:list={[hero && "hero-title"]}>
    {title}{period && <span class="period" aria-hidden="true">.</span>}
  </h1>
  <p class="page-description">{description}</p>

  {hasActions && (
    <div style="margin-top:var(--space-m)">
      <slot name="actions" />
    </div>
  )}
</header>
