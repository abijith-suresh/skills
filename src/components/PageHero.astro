---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  /** Override the default section padding classes */
  sectionClass?: string;
  /** Override the default title class */
  titleClass?: string;
  /** Override the default description class */
  descriptionClass?: string;
}

const {
  eyebrow,
  title,
  description,
  sectionClass = 'pt-16 pb-8',
  titleClass = '',
  descriptionClass = '',
} = Astro.props;
---

<section class={`container-site ${sectionClass}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class={`text-hero font-bold leading-[var(--leading-tighter)] tracking-[var(--tracking-tight)] mt-4 ${titleClass}`}>{title}</h1>
  <p class={`text-body-lg leading-[var(--leading-loose)] max-w-[var(--measure-narrow)] mt-6 ${descriptionClass}`}>{description}</p>

  <div class="mt-8">
    <slot name="actions" />
  </div>
</section>
