---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  /** Override the default section padding classes */
  sectionClass?: string;
  /** Override the default title class */
  titleClass?: string;
  /** Override the default description class */
  descriptionClass?: string;
}

const {
  eyebrow,
  title,
  description,
  sectionClass = 'pt-16 pb-8',
  titleClass = '',
  descriptionClass = '',
} = Astro.props;
---

<section class={`mx-auto w-full max-w-[1200px] px-6 md:px-8 ${sectionClass}`}>
  {eyebrow && <p class="text-xs font-medium tracking-[0.04em] uppercase text-muted">{eyebrow}</p>}
  <h1 class={`text-[clamp(2.5rem,5vw,4rem)] font-semibold leading-[1.05] tracking-[-0.02em] mt-4 ${titleClass}`}>{title}</h1>
  <p class={`text-[1.05rem] leading-[1.65] max-w-[68ch] mt-6 ${descriptionClass}`}>{description}</p>

  <div class="mt-8">
    <slot name="actions" />
  </div>
</section>
