---
import { ArrowLeft } from '@lucide/astro';

interface Props {
  catalogPath: string;
}

const { catalogPath } = Astro.props;
---

<div class="container-site py-5">
  <a href={catalogPath} class="group inline-flex items-center gap-[0.4rem] text-[var(--text-caption)] font-medium leading-none text-muted no-underline uppercase tracking-[var(--tracking-wide)] transition-colors duration-150 py-[0.35rem] hover:text-text">
    <ArrowLeft size={14} stroke-width={2} class="transition-transform duration-150 group-hover:-translate-x-1" />
    Back to Skills
  </a>
</div>
