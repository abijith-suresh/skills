---
import { ArrowLeft } from '@lucide/astro';

interface Props {
  catalogPath: string;
}

const { catalogPath } = Astro.props;
---

<div class="container-site py-5">
  <a href={catalogPath} class="group inline-flex items-center gap-[var(--space-copy-btn-x)] text-caption font-medium leading-none text-muted no-underline uppercase tracking-[var(--tracking-wide)] transition-colors duration-[var(--duration-fast)] py-1.5 hover:text-text focus-visible:text-text">
    <ArrowLeft size={14} stroke-width={2} class="transition-transform duration-[var(--duration-fast)] group-hover:-translate-x-1" aria-hidden="true" />
    Back to Skills
  </a>
</div>
