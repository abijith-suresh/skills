---
interface Props {
  command: string;
  buttonLabel?: string;
}

const { command, buttonLabel = 'Copy' } = Astro.props;
---

<div class="install-block">
  <span class="install-prompt" aria-hidden="true">$</span>
  <code class="install-command">{command}</code>
  <button
    type="button"
    data-copy-command={command}
    data-copy-default={buttonLabel}
    class="install-copy"
  >
    {buttonLabel}
  </button>
</div>
