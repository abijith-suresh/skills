---
interface Props {
  command: string;
  caption?: string;
  buttonLabel?: string;
}

const { command, caption, buttonLabel = 'Copy command' } = Astro.props;
---

<div class="rounded-2xl border border-slate-800/80 bg-slate-900/80 p-4 shadow-lg shadow-slate-950/30 backdrop-blur">
  {caption && (
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">{caption}</p>
  )}

  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <code class="block overflow-x-auto rounded-xl bg-slate-950/90 px-4 py-3 text-sm text-slate-100">{command}</code>
    <button
      type="button"
      data-copy-command={command}
      data-copy-default={buttonLabel}
      class="inline-flex shrink-0 items-center justify-center rounded-xl border border-indigo-400/30 bg-indigo-500/10 px-4 py-2 text-sm font-medium text-indigo-100 transition hover:border-indigo-300/60 hover:bg-indigo-500/20 hover:text-white"
    >
      {buttonLabel}
    </button>
  </div>
</div>
