---
import SectionHeader from './SectionHeader.astro';

interface Props {
  heading: string;
  content?: string;
  variant?: 'default' | 'tinted';
  subtitle?: string;
}

const { heading, content, variant = 'default', subtitle } = Astro.props;
---

{
  variant === 'tinted' ? (
    <section class="container-site pb-24">
      <div class="bg-[var(--color-surface-tinted)] py-10">
        <div class="mb-8">
          <p class="eyebrow">{heading}</p>
          {subtitle && (
            <h2 class="font-mono text-[var(--text-section-title)] font-bold leading-[var(--leading-tight)] tracking-[var(--tracking-tight)] mt-2">
              {subtitle}
            </h2>
          )}
        </div>
        <div class="prose prose-custom max-w-[var(--measure-wide)]">
          <slot />
        </div>
      </div>
    </section>
  ) : (
    <section class="container-site pb-12">
      <SectionHeader eyebrow={heading} as="h2" />
      <div class="prose prose-custom max-w-[var(--measure-wide)]" set:html={content} />
    </section>
  )
}
