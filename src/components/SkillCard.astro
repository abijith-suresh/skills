---
import type { SkillSummary } from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';
import CommandCopy from './CommandCopy.astro';

interface Props {
  skill: SkillSummary;
}

const { skill } = Astro.props;
const detailPath = buildSkillPath(import.meta.env.BASE_URL, skill.slug);
---

<article class="flex h-full flex-col rounded-3xl border border-slate-800/80 bg-slate-900/70 p-6 shadow-lg shadow-slate-950/25 backdrop-blur transition hover:-translate-y-0.5 hover:border-slate-700 hover:bg-slate-900/90">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-indigo-300">skill</p>
      <h2 class="mt-3 text-2xl font-semibold text-white">
        <a href={detailPath} class="transition hover:text-indigo-200">{skill.name}</a>
      </h2>
    </div>
    <span class="rounded-full border border-slate-700 bg-slate-950/70 px-3 py-1 text-xs text-slate-400">
      {skill.slug}
    </span>
  </div>

  <p class="mt-4 text-sm leading-7 text-slate-300">{skill.description}</p>

  <div class="mt-6">
    <CommandCopy command={skill.installCommand} buttonLabel="Copy install" />
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-300">
    <a href={detailPath} class="font-medium text-indigo-200 transition hover:text-white">Read docs →</a>
    <a href={skill.sourceUrl} target="_blank" rel="noreferrer" class="transition hover:text-white">View source ↗</a>
  </div>
</article>
