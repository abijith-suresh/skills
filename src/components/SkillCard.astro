---
import type { SkillSummary } from '../lib/skill-catalog';
import { buildSkillPath } from '../lib/site-paths';

interface Props {
  skill: SkillSummary;
}

const { skill } = Astro.props;
const detailPath = buildSkillPath(import.meta.env.BASE_URL, skill.slug);
---

<a
  href={detailPath}
  class="card h-full accent-hover flex flex-col no-underline"
  style="color: inherit;"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="eyebrow">skill</p>
      <h2 class="heading-md mt-2">{skill.name}</h2>
    </div>
    <span class="eyebrow shrink-0">{skill.slug}</span>
  </div>

  <p class="body-sm mt-4">{skill.description}</p>
</a>
