---
interface Props {
  eyebrow: string;
  heading: string;
  fallbackText?: string;
  /** Set to false to show the fallback text instead of the slot content */
  hasContent?: boolean;
}

const { eyebrow, heading, fallbackText, hasContent = true } = Astro.props;
---

<div>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="heading-md mt-3">{heading}</h2>
  <div class="card mt-6">
    {hasContent ? (
      <div class="markdown">
        <slot />
      </div>
    ) : fallbackText ? (
      <p class="body-sm">{fallbackText}</p>
    ) : null}
  </div>
</div>
