---
interface Props {
  command: string;
  label?: string;
}

const { command, label } = Astro.props;
---

<div>
  {label && <p class="eyebrow" style="margin-bottom:var(--space-2xs)">{label}</p>}
  <div class="code-block-shell">
    <code class="command-code" translate="no">{command}</code>
    <button
      type="button"
      class="copy-button"
      aria-label="Copy install command"
      data-copy-command={command}
    >
      <svg data-copy-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <svg class="hidden" data-check-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="copy-label" data-copy-label>copy</span>
    </button>
    <span class="copy-status" data-copy-status role="status" aria-live="polite" aria-atomic="true"></span>
  </div>
</div>

<script>
  document.addEventListener("click", async (event) => {
    const target =
      event.target instanceof Element ? event.target.closest("[data-copy-command]") : null;
    if (!target) return;

    const command = target.getAttribute("data-copy-command");
    if (!command) return;

    const copyIcon = target.querySelector("[data-copy-icon]");
    const checkIcon = target.querySelector("[data-check-icon]");
    const copyLabel = target.querySelector("[data-copy-label]");
    const copyStatus = target.parentElement?.querySelector("[data-copy-status]");
    const timeoutId = Number(target.getAttribute("data-copy-timeout") || "0");
    window.clearTimeout(timeoutId);

    try {
      await navigator.clipboard.writeText(command);
    } catch {
      window.prompt("Copy this command:", command);
      if (copyLabel) copyLabel.textContent = "try again";
      if (copyStatus) copyStatus.textContent = "use the copy dialog to copy the command";
      return;
    }

    if (copyIcon && checkIcon) {
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
    }
    if (copyLabel) copyLabel.textContent = "copied";
    if (copyStatus) copyStatus.textContent = "install command copied";
    target.setAttribute("aria-label", "Install command copied");

    const timeout = window.setTimeout(() => {
      if (copyIcon && checkIcon) {
        copyIcon.classList.remove("hidden");
        checkIcon.classList.add("hidden");
      }
      if (copyLabel) copyLabel.textContent = "copy";
      if (copyStatus) copyStatus.textContent = "";
      target.setAttribute("aria-label", "Copy install command");
    }, 1600);
    target.setAttribute("data-copy-timeout", String(timeout));
  });
</script>
