---
interface Props {
  command: string;
  label?: string;
}

const { command, label = 'Install' } = Astro.props;
---

<div>
  <p class="text-xs font-medium tracking-[0.04em] uppercase text-muted mb-2">{label}</p>
  <div
    class="flex items-center gap-2 bg-[color-mix(in_srgb,var(--color-text)_5%,var(--color-base))] px-4 py-[0.875rem]"
  >
    <code class="flex-1 font-mono text-sm text-text whitespace-nowrap overflow-x-auto">{command}</code>
    <button
      type="button"
      class="font-sans text-xs font-medium tracking-[0.04em] uppercase text-muted bg-none border-0 cursor-pointer px-[0.4rem] py-[0.2rem] shrink-0 transition-colors duration-150 hover:text-accent"
      data-copy-command={command}
      data-copy-default="Copy"
    >
      Copy
    </button>
  </div>
</div>
