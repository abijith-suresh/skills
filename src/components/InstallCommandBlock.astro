---
interface Props {
  command: string;
  label?: string;
}

const { command, label = 'Install' } = Astro.props;
---

<div>
  <p class="eyebrow mb-2">{label}</p>
  <div
    class="code-block-shell"
  >
    <code class="flex-1 font-mono text-sm text-text whitespace-nowrap overflow-x-auto">{command}</code>
    <button
      type="button"
      class="copy-button"
      data-copy-command={command}
      data-copy-default="Copy"
    >
      Copy
    </button>
  </div>
</div>
