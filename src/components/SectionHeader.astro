---
interface Props {
  eyebrow: string;
  heading: string;
  description?: string;
}

const { eyebrow, heading, description } = Astro.props;
---

<div>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="heading-lg mt-3">{heading}</h2>
  {description && <p class="body-sm mt-2 max-w-xl">{description}</p>}
</div>
